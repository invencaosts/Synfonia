# Copie este arquivo para .env e troque os valores iniciados por "troque_".
# Nunca versione o arquivo .env com credenciais reais.

# Ativa apenas os ajustes locais: criacao/atualizacao de tabelas e indices.
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=db_usuarios_musicas
DB_USER=musicas_user
DB_PASS=troque_esta_senha_postgres

# MongoDB
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=musicas
MONGO_USER=mongo_user
MONGO_PASSWORD=troque_esta_senha_mongodb

# JWT (JWT_SECRET precisa ter pelo menos 32 caracteres)
JWT_SECRET=troque_esta_chave_jwt_local_com_32_caracteres
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# Servidor e comunicacao com o frontend
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Usuario administrativo do Spring Security (opcional)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque_esta_senha_de_administrador

# Spotify (opcional; necessario para testar a integracao)
SPOTIFY_CLIENT_ID=troque_pelo_client_id
SPOTIFY_CLIENT_SECRET=troque_pelo_client_secret
SPOTIFY_REDIRECT_URI=http://localhost:5173/callback

# YT Music (microservico Python/ytmusicapi, sobe via docker compose)
YTMUSIC_SERVICE_URL=http://localhost:8001
YTMUSIC_PORT=8001

# SMTP (opcional; necessario para testar recuperacao de senha)
MAIL_HOST=localhost
MAIL_PORT=2525
MAIL_USER=troque_pelo_usuario_smtp
MAIL_PASS=troque_pela_senha_smtp

# SonarQube (opcional; usado somente com o profile "quality" do Compose)
SONAR_DB_NAME=sonarqube
SONAR_DB_USER=sonar_user
SONAR_DB_PASS=troque_esta_senha_sonarqube
